{
  "name": "fo-tracker",
  "version": "3.0.0",
  "private": true,
  "description": "Consent-based tracker for employer-issued field-officer phones, with site-visit check-ins",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
