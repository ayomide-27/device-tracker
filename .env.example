# Copy to .env for running on your own computer: npm run dev
# On Render, set these in the service's Environment tab instead. Never commit the real .env file.

DATABASE_URL=postgres://user:password@host/dbname   # Neon connection string
DASHBOARD_PASSWORD=choose-a-long-passphrase          # protects the dashboard and all location data
DEVICE_KEY=                                          # optional access code the FOs' phones must enter
GOOGLE_MAPS_API_KEY=                                 # leave empty to use OpenStreetMap
GOOGLE_MAP_ID=DEMO_MAP_ID
RETENTION_DAYS=90
TIMEZONE=Africa/Lagos
